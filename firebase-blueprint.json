{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student or administrator profile document",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full display name of student" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["student", "super_admin"] },
        "selectedClass": { "type": "integer", "description": "Selected class number (5-10)" },
        "selectedStream": { "type": "string", "enum": ["NONE", "SCIENCE", "HUMANITIES", "BUSINESS"] },
        "photoUrl": { "type": "string", "description": "Optional avatar URL" },
        "isActive": { "type": "boolean", "description": "Whether user account is active" },
        "accountDeletionRequested": { "type": "boolean", "description": "Whether user requested account deletion" },
        "createdAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "name", "email", "role", "selectedClass", "selectedStream", "isActive", "accountDeletionRequested", "createdAt", "updatedAt"]
    },
    "EducationLevel": {
      "title": "EducationLevel",
      "description": "Slim educational level category (SSC, HSC, Graduate, or custom Super Admin level)",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleBn": { "type": "string" },
        "subtitleBn": { "type": "string" },
        "minClassNumber": { "type": "integer" },
        "maxClassNumber": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "titleEn", "titleBn", "minClassNumber", "maxClassNumber", "isActive", "sortOrder", "createdAt", "updatedAt"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "School class configuration (Classes 1-30)",
      "type": "object",
      "properties": {
        "classNumber": { "type": "integer" },
        "nameBn": { "type": "string" },
        "nameEn": { "type": "string" },
        "hasStreams": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "educationLevelId": { "type": "string" },
        "educationLevelNameBn": { "type": "string" },
        "educationLevelNameEn": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classNumber", "nameBn", "nameEn", "hasStreams", "isActive", "sortOrder", "createdAt", "updatedAt"]
    },
    "AcademicStream": {
      "title": "AcademicStream",
      "description": "Academic stream for Classes 9 and 10",
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["SCIENCE", "HUMANITIES", "BUSINESS"] },
        "nameBn": { "type": "string" },
        "nameEn": { "type": "string" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "nameBn", "nameEn", "isActive", "sortOrder", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic subject dynamically assigned to classes and streams",
      "type": "object",
      "properties": {
        "nameBn": { "type": "string" },
        "nameEn": { "type": "string" },
        "classNumber": { "type": "integer" },
        "stream": { "type": "string", "enum": ["ALL", "SCIENCE", "HUMANITIES", "BUSINESS"] },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameBn", "nameEn", "classNumber", "stream", "isActive", "sortOrder", "createdAt", "updatedAt"]
    },
    "Textbook": {
      "title": "Textbook",
      "description": "Authorized NCTB original textbook metadata and PDF reference",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectNameBn": { "type": "string" },
        "subjectNameEn": { "type": "string" },
        "classNumber": { "type": "integer" },
        "stream": { "type": "string", "enum": ["ALL", "SCIENCE", "HUMANITIES", "BUSINESS"] },
        "academicYear": { "type": "string" },
        "edition": { "type": "string" },
        "author": { "type": "string" },
        "publisher": { "type": "string" },
        "shortDescription": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string", "enum": ["BN", "EN"] },
        "pageCount": { "type": "integer" },
        "coverUrl": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "coverStoragePath": { "type": "string", "description": "Firebase Storage object path for uploaded cover image" },
        "pdfStoragePath": { "type": "string", "description": "Firebase Storage object path for uploaded original complete PDF" },
        "coverFileName": { "type": "string" },
        "coverFileSizeBytes": { "type": "integer" },
        "pdfFileName": { "type": "string" },
        "pdfFileSizeBytes": { "type": "integer" },
        "isPremium": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "allowDownload": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "tableOfContents": { "type": "string", "description": "Bounded list of chapter entries" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titleBn", "subjectId", "subjectNameBn", "classNumber", "stream", "academicYear", "edition", "language", "pageCount", "pdfUrl", "isPremium", "isPublished", "allowDownload", "isPopular", "createdAt", "updatedAt"]
    },
    "GuideNote": {
      "title": "GuideNote",
      "description": "Authorized guide, chapter note, CQ, MCQ, or suggestion document",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "classNumber": { "type": "integer" },
        "stream": { "type": "string", "enum": ["ALL", "SCIENCE", "HUMANITIES", "BUSINESS"] },
        "subjectId": { "type": "string" },
        "subjectNameBn": { "type": "string" },
        "subjectNameEn": { "type": "string" },
        "chapter": { "type": "string" },
        "guideType": { "type": "string" },
        "academicYear": { "type": "string" },
        "language": { "type": "string", "enum": ["BN", "EN"] },
        "author": { "type": "string" },
        "publisher": { "type": "string" },
        "edition": { "type": "string" },
        "shortDescription": { "type": "string" },
        "summaryContent": { "type": "string" },
        "tableOfContents": { "type": "string", "description": "Bounded list of chapter/section entries" },
        "pdfUrl": { "type": "string" },
        "coverUrl": { "type": "string" },
        "coverStoragePath": { "type": "string" },
        "pdfStoragePath": { "type": "string" },
        "coverFileName": { "type": "string" },
        "coverFileSizeBytes": { "type": "integer" },
        "pdfFileName": { "type": "string" },
        "pdfFileSizeBytes": { "type": "integer" },
        "pageCount": { "type": "integer" },
        "isPremium": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "allowDownload": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titleBn", "classNumber", "stream", "subjectId", "subjectNameBn", "chapter", "guideType", "isPremium", "isPublished", "allowDownload", "createdAt", "updatedAt"]
    },
    "GeneralKnowledgeItem": {
      "title": "GeneralKnowledgeItem",
      "description": "Category-based General Knowledge Q&A item",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "questionBn": { "type": "string" },
        "questionEn": { "type": "string" },
        "answerBn": { "type": "string" },
        "answerEn": { "type": "string" },
        "explanationBn": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["category", "questionBn", "answerBn", "isPublished", "isDemo", "createdAt", "updatedAt"]
    },
    "ExamTest": {
      "title": "ExamTest",
      "description": "MCQ test definition without answer keys",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "examType": { "type": "string", "enum": ["SUBJECT", "CHAPTER", "MODEL"] },
        "classNumber": { "type": "integer" },
        "stream": { "type": "string" },
        "subjectNameBn": { "type": "string" },
        "chapter": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "totalMarks": { "type": "integer" },
        "questionCount": { "type": "integer" },
        "questions": { "type": "string", "description": "Bounded list of question stem/option maps without correct indices" },
        "isPublished": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titleBn", "examType", "classNumber", "stream", "subjectNameBn", "durationMinutes", "totalMarks", "questionCount", "isPublished", "isDemo", "createdAt", "updatedAt"]
    },
    "ExamAnswerKey": {
      "title": "ExamAnswerKey",
      "description": "Protected MCQ answer key accessible only to Super Admin or after student submission",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "correctIndices": { "type": "string", "description": "Bounded list of 0-3 option indices" },
        "explanations": { "type": "string", "description": "Bounded list of explanations" },
        "isPublished": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examId", "correctIndices", "explanations", "isPublished", "updatedAt"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Student MCQ submission and result record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "examId": { "type": "string" },
        "examTitleBn": { "type": "string" },
        "selectedAnswers": { "type": "string" },
        "score": { "type": "integer" },
        "totalMarks": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "status": { "type": "string", "enum": ["SUBMITTED", "GRADED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "examId", "examTitleBn", "selectedAnswers", "score", "totalMarks", "correctCount", "totalQuestions", "status", "createdAt", "updatedAt"]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "Class-based subscription plan (1, 3, 6, 12 months) with locked BDT price and benefits",
      "type": "object",
      "properties": {
        "nameBn": { "type": "string" },
        "nameEn": { "type": "string" },
        "descriptionBn": { "type": "string" },
        "benefits": { "type": "string", "description": "Bounded list of plan benefit strings" },
        "classNumber": { "type": "integer" },
        "stream": { "type": "string" },
        "durationMonths": { "type": "integer", "enum": [1, 3, 6, 12] },
        "priceBdt": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "educationLevelId": { "type": "string" },
        "educationLevelNameBn": { "type": "string" },
        "educationLevelNameEn": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameBn", "classNumber", "stream", "durationMonths", "priceBdt", "isActive", "createdAt", "updatedAt"]
    },
    "PaymentMethodConfig": {
      "title": "PaymentMethodConfig",
      "description": "Super Admin managed dynamic payment method (bKash, Nagad, Rocket, Bank Transfer)",
      "type": "object",
      "properties": {
        "methodType": { "type": "string", "enum": ["BKASH", "NAGAD", "ROCKET", "BANK_TRANSFER"] },
        "methodName": { "type": "string" },
        "accountNumber": { "type": "string", "description": "Wallet mobile number or bank account number" },
        "accountHolderName": { "type": "string" },
        "accountType": { "type": "string", "description": "Personal, Agent, Merchant, or Bank Account" },
        "transactionType": { "type": "string", "enum": ["Send Money", "Cash Out", "Payment", "Bank Transfer"] },
        "bankName": { "type": "string" },
        "branchName": { "type": "string" },
        "routingNumber": { "type": "string" },
        "paymentInstructions": { "type": "string" },
        "isActive": { "type": "boolean" },
        "displayOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["methodType", "methodName", "accountNumber", "accountType", "transactionType", "isActive", "displayOrder", "createdAt", "updatedAt"]
    },
    "UsedTransactionLock": {
      "title": "UsedTransactionLock",
      "description": "Server-enforced uniqueness lock preventing duplicate Transaction ID reuse across payment requests",
      "type": "object",
      "properties": {
        "normalizedTrxId": { "type": "string" },
        "transactionReference": { "type": "string" },
        "requestId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["RESERVED", "APPROVED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["normalizedTrxId", "transactionReference", "requestId", "userId", "status", "createdAt", "updatedAt"]
    },
    "SubscriptionRequest": {
      "title": "SubscriptionRequest",
      "description": "Manual payment verification request submitted by student with immutable payment receiver & transaction type snapshots",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planNameBn": { "type": "string" },
        "classNumber": { "type": "integer" },
        "stream": { "type": "string" },
        "durationMonths": { "type": "integer" },
        "amountBdt": { "type": "integer" },
        "paymentMethodId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionType": { "type": "string", "enum": ["Send Money", "Cash Out", "Payment", "Bank Transfer"] },
        "receiverNumber": { "type": "string" },
        "accountHolderName": { "type": "string" },
        "transactionReference": { "type": "string" },
        "normalizedTrxId": { "type": "string" },
        "senderNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "adminNote": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "verifiedBy": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "planId", "planNameBn", "classNumber", "stream", "durationMonths", "amountBdt", "paymentMethod", "transactionReference", "normalizedTrxId", "status", "createdAt", "updatedAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Admin-verified active class subscription record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "planId": { "type": "string" },
        "planNameBn": { "type": "string" },
        "classNumber": { "type": "integer" },
        "stream": { "type": "string" },
        "durationMonths": { "type": "integer" },
        "amountBdt": { "type": "integer" },
        "paymentMethod": { "type": "string" },
        "transactionReference": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "REVOKED"] },
        "startDate": { "type": "string", "format": "date-time" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "approvedByUid": { "type": "string" },
        "requestId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "planId", "planNameBn", "classNumber", "stream", "durationMonths", "status", "startDate", "expiryDate", "approvedByUid", "createdAt", "updatedAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Real-time in-app notification for Admin payment requests and Student payment approval/rejection alerts",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string" },
        "senderUid": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "notificationType": { "type": "string", "enum": ["PAYMENT_REQUEST_SUBMITTED", "PAYMENT_APPROVED", "PAYMENT_REJECTED", "SYSTEM"] },
        "relatedPaymentRequestId": { "type": "string" },
        "studentName": { "type": "string" },
        "planName": { "type": "string" },
        "amountBdt": { "type": "integer" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "senderUid", "title", "message", "notificationType", "isRead", "createdAt", "updatedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Private user bookmark for whole books, individual pages, guides, or GK items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookmarkType": { "type": "string", "enum": ["BOOK", "PAGE", "GUIDE", "GK"] },
        "targetId": { "type": "string" },
        "titleBn": { "type": "string" },
        "subtitleBn": { "type": "string" },
        "classNumber": { "type": "integer" },
        "pageNumber": { "type": "integer" },
        "coverUrl": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookmarkType", "targetId", "titleBn", "pageNumber", "isPremium", "createdAt", "updatedAt"]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "Private user reading progress and last read page restoration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "contentId": { "type": "string" },
        "contentType": { "type": "string", "enum": ["BOOK", "GUIDE"] },
        "titleBn": { "type": "string" },
        "subjectNameBn": { "type": "string" },
        "classNumber": { "type": "integer" },
        "stream": { "type": "string" },
        "coverUrl": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "lastPage": { "type": "integer" },
        "totalPages": { "type": "integer" },
        "progressPercent": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "contentId", "contentType", "titleBn", "classNumber", "stream", "isPremium", "lastPage", "totalPages", "progressPercent", "createdAt", "updatedAt"]
    },
    "UserNote": {
      "title": "UserNote",
      "description": "Strictly private student personal notebook entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "subjectTag": { "type": "string" },
        "colorIndex": { "type": "integer" },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "colorIndex", "isPinned", "createdAt", "updatedAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "School library official notice or announcement",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string" },
        "bodyBn": { "type": "string" },
        "category": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "isImportant": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titleBn", "bodyBn", "category", "isPublished", "isImportant", "createdAt", "updatedAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Centralized download permissions and application settings",
      "type": "object",
      "properties": {
        "downloadsEnabled": { "type": "boolean" },
        "allowTextbookDownload": { "type": "boolean" },
        "allowGuideDownload": { "type": "boolean" },
        "allowNoteDownload": { "type": "boolean" },
        "defaultTheme": { "type": "string", "enum": ["SYSTEM", "LIGHT", "DARK"] },
        "defaultLanguage": { "type": "string", "enum": ["BN", "EN"] },
        "announcementBannerBn": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "privacyPolicyBn": { "type": "string" },
        "termsAndConditionsBn": { "type": "string" },
        "deletedDefaultClassIds": { "type": "string", "description": "List of deleted default class IDs" },
        "deletedDefaultLevelIds": { "type": "string", "description": "List of deleted default education level IDs" },
        "deletedDefaultPlanIds": { "type": "string", "description": "List of deleted default plan IDs" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["downloadsEnabled", "allowTextbookDownload", "allowGuideDownload", "allowNoteDownload", "defaultTheme", "defaultLanguage", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "User profiles" },
    "/education_levels/{levelId}": { "schema": "EducationLevel", "description": "Educational levels (SSC, HSC, Graduate, etc.)" },
    "/classes/{classId}": { "schema": "SchoolClass", "description": "Active school classes" },
    "/streams/{streamId}": { "schema": "AcademicStream", "description": "Streams for classes 9-10" },
    "/subjects/{subjectId}": { "schema": "Subject", "description": "Dynamic subjects" },
    "/books/{bookId}": { "schema": "Textbook", "description": "Original NCTB textbooks" },
